{
  "name": "latent-print-minutiae-extractor",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  // Use the host NVIDIA GPU if one is available (VS Code passes --gpus all); harmless on CPU-only hosts.
  // If your tooling doesn't honour this, add:  "runArgs": ["--gpus", "all"]
  "hostRequirements": { "gpu": "optional" },
  "containerEnv": { "NVIDIA_DRIVER_CAPABILITIES": "compute,utility" },
  // Install runtime + dev deps (CPU torch), then auto-swap to the CUDA build IF a GPU is visible
  // (gpu-setup.sh: cu130 supports Blackwell/sm_120). On CPU-only hosts the second step is a no-op.
  "postCreateCommand": "pip install --no-cache-dir -r requirements-dev.txt && bash .devcontainer/gpu-setup.sh",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "ms-python.debugpy"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  }
}
